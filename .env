# COMPOSE PROJECT - имя, которое будет использоваться в названии контейнеров обеспечивающих работу
COMPOSE_PROJECT_NAME=mc_erchov_ru

# имя домена, которое будет прописано в контейнере
HOSTNAME=domain.com

# папка для хранения файлов - где хранятся все файлы которые необходимо сохранять
DATA_PATH=/path/to/MeshCentral

# ip адрес - адрес, на котором будут работать службы
HTTP_IP=192.168.XXX.YYY

# порты на котором будет запущен сервисы
HTTPS_PORT=1443

# mongo
MESHUSER=meshuser
MESHOASSWORD=STRONG_PASSWORD
